{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArrangeIt",
  "version": "1.0.0",
  "identifier": "com.arrangeit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ArrangeIt",
        "width": 1320,
        "height": 880,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": "Dark",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Utility",
    "shortDescription": "Local-first file organizer",
    "longDescription": "ArrangeIt sorts folders by date, type, size, similarity, name or extension, finds duplicate files, batch-renames and restyles folders — all on-device with Rust-speed scanning.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"]
      }
    }
  }
}
